# The backend image is built from the repository root and copies the package and the API by
# name (see backend/Dockerfile). Everything else stays out of the build context.
*
!pyproject.toml
!oxcart/
oxcart/*
!oxcart/*.py
!backend/
backend/*
!backend/requirements.txt
!backend/app/
**/__pycache__/
**/*.pyc
**/.env*

# Oxcart — environment template. Copy to `.env` at the repo root and fill in.
# `.env` is git-ignored: never commit it.

# ---------------------------------------------------------------------------
# The app (backend/ and frontend/): FastAPI backend + Next.js frontend
# ---------------------------------------------------------------------------
# Neo4j. Local default shown. For Neo4j Aura use the neo4j+s:// URI and set
# NEO4J_DATABASE to the database name Aura gives you (it is not "neo4j").
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Weaviate (read-only). Ports match docker-compose.yml.
WEAVIATE_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8085
WEAVIATE_GRPC_PORT=50056
OXCART_COLLECTION=Oxcart
# Only when the Weaviate instance requires an API key. Empty = anonymous.
WEAVIATE_API_KEY=

# Optional. The question page: with it the backend embeds the question itself (text-embedding-3-large) and
# searches the literature by that vector (near_vector) and the catalogue by its vector index; without it the
# literature is searched by keywords (BM25) and the catalogue by its full-text index. The explorer searches by
# keywords (BM25), and with the key adds a hybrid pass that uses Weaviate's own OpenAI vectorizer:
# docker-compose.yml passes the same variable to the Weaviate container for that.
OPENAI_API_KEY=

# Optional. The written answer: the model's key (Anthropic). Without it the question page shows the evidence
# and no written answer.
ANTHROPIC_API_KEY=

# Weaviate Cloud only. A cluster's address: when set, the backend and the eval search that cluster (with
# WEAVIATE_API_KEY above) and the local Weaviate above is not used. Leave it commented out for a local run.
# WEAVIATE_URL=

# Optional. Figures of the cited pages: the figures host's address (https), which serves each
# crop as <id>.png. Empty = figures are off. FIGURES_REMOVED: comma-separated ids never named.
# The page's build takes the same address as NEXT_PUBLIC_FIGURES_BASE (frontend/.env.example).
FIGURES_BASE=
FIGURES_REMOVED=

# Optional. The web step (backend/README.md, "The web step"): ASK_WEB on (1, true, yes, on) turns it on;
# TAVILY_API_KEY is the search service's key (without it no search is made); WEB_QUERY_SUFFIX replaces the
# fixed words added to a search (unset: "Costa Rica philately"; set empty: none), so it stays commented out
# here. The page's build takes NEXT_PUBLIC_WEB (frontend/.env.example).
ASK_WEB=
TAVILY_API_KEY=
# WEB_QUERY_SUFFIX=

# Optional. The API listens on 127.0.0.1:8090 unless these are set.
# API_HOST=127.0.0.1
# API_PORT=8090

# ---------------------------------------------------------------------------
# The pipeline and notebooks (pipeline/, notebooks/): only to rebuild the corpus
# ---------------------------------------------------------------------------
# Read by pipeline/philatelic_weaviate.py, scripts/load_cluster.py and the notebooks
# (notebooks/philatelic_rag.ipynb, langchain_rag_philatelic.ipynb, gradio_app.ipynb).
# The pipeline's own Weaviate address is WEAVIATE_URL too (its default: http://localhost:8083). Do not set it
# in this file for a local run: the backend and the eval read the same name as a Weaviate Cloud cluster (above).
# Set it in the shell that runs the pipeline instead.
WEAVIATE_COLLECTION_NAME=Oxcart
OPENAI_CHAT_MODEL=gpt-3.5-turbo
MAX_SEARCH_RESULTS=5
SEARCH_SIMILARITY_THRESHOLD=0.7
PHILATELIC_JSONS_DIR=./results/parsed_jsons
LOGS_DIR=./logs
GRADIO_PORT=7860
GRADIO_SHARE=false
LOG_LEVEL=INFO
DEV_MODE=true

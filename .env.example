# Oxcart — environment template. Copy to `.env` at the repo root and fill in.
# `.env` is git-ignored: never commit it.

# ---------------------------------------------------------------------------
# The app (backend/ and frontend/): FastAPI backend + Next.js frontend
# ---------------------------------------------------------------------------
# Neo4j. Local default shown. For Neo4j Aura use the neo4j+s:// URI and set
# NEO4J_DATABASE to the database name Aura gives you (it is not "neo4j").
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Weaviate (read-only). Ports match docker-compose.yml.
WEAVIATE_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8085
WEAVIATE_GRPC_PORT=50056
OXCART_COLLECTION=Oxcart
# Only when the Weaviate instance requires an API key. Empty = anonymous.
WEAVIATE_API_KEY=

# Optional. Without it the app searches Weaviate by keywords (BM25). With it,
# Weaviate also searches by meaning (hybrid), using its own OpenAI vectorizer.
# docker-compose.yml passes the same variable to the Weaviate container.
OPENAI_API_KEY=

# Optional. Figures of the cited pages: the figures host's address (https), which serves each
# crop as <id>.png. Empty = figures are off. FIGURES_REMOVED: comma-separated ids never named.
# The page's build takes the same address as NEXT_PUBLIC_FIGURES_BASE (frontend/.env.example).
FIGURES_BASE=
FIGURES_REMOVED=

# Optional. The API listens on 127.0.0.1:8090 unless these are set.
# API_HOST=127.0.0.1
# API_PORT=8090

# ---------------------------------------------------------------------------
# The pipeline and notebooks (pipeline/, notebooks/): only to rebuild the corpus
# ---------------------------------------------------------------------------
WEAVIATE_URL=http://localhost:8085
WEAVIATE_COLLECTION_NAME=Oxcart
OPENAI_CHAT_MODEL=gpt-3.5-turbo
MAX_SEARCH_RESULTS=5
SEARCH_SIMILARITY_THRESHOLD=0.7
PHILATELIC_JSONS_DIR=./results/parsed_jsons
LOGS_DIR=./logs
GRADIO_PORT=7860
GRADIO_SHARE=false
LOG_LEVEL=INFO
DEV_MODE=true

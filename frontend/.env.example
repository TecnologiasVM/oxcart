# ---------------------------------------------------------------------------
# Frontend env (Next.js). The frontend makes NO direct LLM/OpenAI/Anthropic
# calls — all data flows through the FastAPI backend.
# ---------------------------------------------------------------------------

# API base for the BROWSER. Default (empty) = use the Next.js reverse proxy:
# the browser calls relative /api/* on this origin and Next rewrites to FastAPI
# server-side (see next.config.ts). Only port 3000 needs to be exposed;
# FastAPI on 8090 stays internal; no CORS needed.
# Set to an absolute URL (http://localhost:8090) only for legacy direct mode.
NEXT_PUBLIC_API_BASE=

# Internal upstream the Next.js proxy forwards /api/* to (server-side only).
# Use 127.0.0.1 (not localhost) to avoid the IPv6 ::1 resolution delay.
BACKEND_ORIGIN=http://127.0.0.1:8090

# Dev only: hosts other devices use to reach this machine (comma-separated),
# needed when the dev server is opened from a phone or another computer
# (`npm run dev:lan`). Empty = this machine only.
ALLOWED_DEV_ORIGINS=

# Optional. The figures host (https): the page draws the figures of the cited pages from it
# (<id>.png) and reads the first screen's plate from it (first-screen.json, a list of
# {digest, width, height}). Empty = no picture is drawn. The backend's FIGURES_BASE names the
# same host. Read at build time.
NEXT_PUBLIC_FIGURES_BASE=
